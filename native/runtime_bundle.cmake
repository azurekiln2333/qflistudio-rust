set(QFLI_NATIVE_RUNTIME_ROOT "${CMAKE_CURRENT_LIST_DIR}/build/runtime")
get_filename_component(QFLI_NATIVE_PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(qfli_install_runtime platform destination)
  if(FLUTTER_TARGET_PLATFORM MATCHES "arm64")
    set(architecture "arm64")
  elseif(FLUTTER_TARGET_PLATFORM MATCHES "x64")
    set(architecture "x64")
  elseif(CMAKE_GENERATOR_PLATFORM STREQUAL "x64")
    set(architecture "x64")
  elseif(CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64" OR
         CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(architecture "arm64")
  else()
    set(architecture "x64")
  endif()
  set(runtime_root "${QFLI_NATIVE_RUNTIME_ROOT}/${platform}-${architecture}")
  if(EXISTS "${runtime_root}/native-libraries.cmake")
    include("${runtime_root}/native-libraries.cmake")
    foreach(library IN LISTS QFLI_RUNTIME_LIBRARIES)
      if(NOT EXISTS "${runtime_root}/${library}")
        message(FATAL_ERROR "Packaged Rust runtime library is missing: ${library}")
      endif()
      install(FILES "${runtime_root}/${library}" DESTINATION "${destination}" COMPONENT Runtime)
    endforeach()
  elseif(EXISTS "${QFLI_NATIVE_PROJECT_ROOT}/assets/miri/manifest.${platform}-${architecture}.json")
    message(FATAL_ERROR "Rust runtime manifest exists without its native package; run package_miri_runtime.py")
  endif()
endfunction()
