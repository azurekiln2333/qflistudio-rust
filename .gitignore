# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
# flutter tool 在包目录里落的状态文件（含 workspace 成员）
.flutter
.flutter_tool_state
.pub-cache/
.pub/
**/build/
**/.dart_tool/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 第三方原生解释器源码：按 apps/qfli_c/native/README.md 的命令 clone 进来，
# 不进版本库（上游在 GitLab，自己 clone 比在这里维护一份副本可靠）。
/apps/qfli_c/native/third_party/picoc/

# HarmonyOS 原生构建产物
/apps/qfli_c/ohos/**/build/
/apps/qfli_c/ohos/**/oh_modules/
/apps/qfli_c/ohos/**/node_modules/
/apps/qfli_c/ohos/**/.hvigor/
/apps/qfli_c/ohos/entry/libs/

# The same generated platform directories exist in every language App.
**/ohos/**/build/
**/ohos/**/oh_modules/
**/ohos/**/node_modules/
**/ohos/**/.hvigor/
**/ohos/entry/libs/

# Native language runtime build output
**/native/build/
/android/app/src/main/jniLibs/
/scripts/__pycache__/

# Generated upstream MIR standard library, codegen backend and license bundle.
/assets/miri/*
!/assets/miri/.gitkeep

# Local AI/editor tool state; project instructions remain tracked in .agents/.trellis.
/.agent/
/.claude/
/.codebuddy/
/.cursor/
/.gemini/
/.pi/
/.qoder/
/.workbuddy-ai/
/.zcode/

# Portable agent knowledge: only reviewed Markdown skills/references are visible.
# Keep other .agents content and future skills local until explicitly reviewed.
/.agents/**
!/.agents/skills/
!/.agents/skills/trellis-before-dev/
!/.agents/skills/trellis-before-dev/**/
!/.agents/skills/trellis-before-dev/**/*.md
!/.agents/skills/trellis-brainstorm/
!/.agents/skills/trellis-brainstorm/**/
!/.agents/skills/trellis-brainstorm/**/*.md
!/.agents/skills/trellis-break-loop/
!/.agents/skills/trellis-break-loop/**/
!/.agents/skills/trellis-break-loop/**/*.md
!/.agents/skills/trellis-channel/
!/.agents/skills/trellis-channel/**/
!/.agents/skills/trellis-channel/**/*.md
!/.agents/skills/trellis-check/
!/.agents/skills/trellis-check/**/
!/.agents/skills/trellis-check/**/*.md
!/.agents/skills/trellis-continue/
!/.agents/skills/trellis-continue/**/
!/.agents/skills/trellis-continue/**/*.md
!/.agents/skills/trellis-finish-work/
!/.agents/skills/trellis-finish-work/**/
!/.agents/skills/trellis-finish-work/**/*.md
!/.agents/skills/trellis-meta/
!/.agents/skills/trellis-meta/**/
!/.agents/skills/trellis-meta/**/*.md
!/.agents/skills/trellis-session-insight/
!/.agents/skills/trellis-session-insight/**/
!/.agents/skills/trellis-session-insight/**/*.md
!/.agents/skills/trellis-spec-bootstrap/
!/.agents/skills/trellis-spec-bootstrap/**/
!/.agents/skills/trellis-spec-bootstrap/**/*.md
!/.agents/skills/trellis-start/
!/.agents/skills/trellis-start/**/
!/.agents/skills/trellis-start/**/*.md
!/.agents/skills/trellis-update-spec/
!/.agents/skills/trellis-update-spec/**/
!/.agents/skills/trellis-update-spec/**/*.md

# Trellis workflow/config/scripts/specs/tasks/journals are portable source.
# Its nested .gitignore keeps identity/session/runtime state local.
/.dsh/
/.trellis/.template-hashes.json

# Tool caches and generated native/package outputs, including nested packages.
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.gradle/
**/.cxx/
**/node_modules/
**/target/
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib
*.exe
*.apk
*.aab
*.hap
*.hsp
*.ipa
*.msix
*.msixbundle
*.appx
*.appxbundle
*.dmg
*.msi
